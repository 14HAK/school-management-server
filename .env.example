# ==========================================
# School ERP Backend - Environment Variables
# ==========================================

# App
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
MONGODB_URI=MONGODB_URI

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_SECRET=change_this_cookie_secret

# CORS
CLIENT_URL=http://localhost:5173/

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cloudinary (Future)
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=school_erp
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET
# ----- Stripe (added in Phase 6 - payments) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# nodemailer
#nodemailer
SMTP_EMAIL=example@gmail.com
SMTP_PASSWORD=password_nodemailer
FROM_NAME=school_erp
FROM_EMAIL=noreply@school_erp.com

# Redis (Future)
REDIS_URL=
